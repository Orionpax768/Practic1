<Window x:Class="Practic1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Practic1"
        mc:Ignorable="d"
        Title="MainWindow" Height="500" Width="750">
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/istockphoto-2050245827-612x612.jpg" Stretch="UniformToFill"/>
        </Grid.Background>
        <Grid ShowGridLines="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Label Content="Вызов принят!" Grid.Row="0" Grid.Column="0" 
                   Foreground="#FF00E6B6" FontSize="14" FontWeight="Bold"
                   HorizontalAlignment="Left" VerticalAlignment="Top" Margin="15,15,0,0"/>
            <StackPanel Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="20,0,0,0">
                <Label Content="Вызов 1:" Foreground="White" Padding="0,0,0,5"/>
                <TextBox x:Name="txtBox1" TextWrapping="Wrap" Width="160" Height="35"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="20,0,0,0">
                <Label Content="Вызов 2:" Foreground="White" Padding="0,0,0,5"/>
                <TextBox x:Name="txtBox2" TextWrapping="Wrap" Width="160" Height="35"/>
            </StackPanel>
            <Button x:Name="btnStart" Content="Вперёд!" Grid.Row="2" Grid.Column="0" 
                    Width="140" Height="40" 
                    HorizontalAlignment="Left" VerticalAlignment="Bottom" 
                    Margin="20,0,0,20" Click="btnStart_Click"/>
        </Grid>
    </Grid>
</Window>